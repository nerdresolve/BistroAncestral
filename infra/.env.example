# Copie para infra/.env e preencha. O arquivo .env real nao vai para o
# repositorio (.gitignore cobre .env.*).

# Dominio publico do site. Entra no build: canonical, sitemap e JSON-LD sao
# gerados em tempo de compilacao.
NEXT_PUBLIC_SITE_URL=https://bistro.nerdresolve.com

# Google Tag Manager. Mesmo container do site em WordPress.
NEXT_PUBLIC_GTM_ID=GTM-KTKQZQTP

# Tunel do Cloudflare. O UUID sai de `cloudflared tunnel list`; o arquivo de
# credenciais correspondente fica em ~/.cloudflared/<UUID>.json e nunca entra
# no repositorio.
CLOUDFLARE_TUNNEL_ID=00000000-0000-0000-0000-000000000000
